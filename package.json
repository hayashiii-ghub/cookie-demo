{
  "name": "cookie-demo",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "video:prepare": "node video/prepare.mjs",
    "video:dev": "npm run video:prepare && hyperframes preview .video-dist",
    "video:check": "npm run video:prepare && npm run video:check:prepared",
    "video:check:prepared": "hyperframes check .video-dist --samples 9 --no-contrast",
    "video:render": "npm run video:prepare && npm run video:render:prepared",
    "video:render:prepared": "hyperframes render .video-dist --quality high --strict --output video/renders/cookie-reel.mp4",
    "astro": "astro"
  },
  "devDependencies": {
    "@hayashiii/shimon": "^0.2.0",
    "astro": "^7.0.6",
    "hyperframes": "0.7.86"
  }
}
