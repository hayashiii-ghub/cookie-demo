---
import '../styles/reel.css';
import Reel from '../components/Reel.astro';
---

<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>y2k design.md · LOOK 02 — COOKIE (NewJeans MV 2:13→2:20)</title>
</head>
<body>
<Reel />

<div class="track" id="track" aria-hidden="true"></div>

<script>
  /* the reel's JS lives in src/scripts/ — five modules, bundled + minified by Astro, so
     the design notes in them stay in the source and out of the shipped page. transport.js
     is the entry: importing it runs util → stage → cookie → frame → wiring in the same
     order the old inline script did. */
  import '../scripts/transport.js';
</script>
</body>
</html>
